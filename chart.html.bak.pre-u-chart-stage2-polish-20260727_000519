<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Clawmimoto — Chart</title>
<meta name="description" content="Live annotated chart — Entry, SL, TP straight from the Clawmimoto engine.">
<!-- U-CHART-STAGE1-20260726: annotated chart page. Served at /chart/<symbol> via vercel.json rewrite.
     Stage 1 scope: working chart + price lines + Telegram link. Stage 2 (later): direction
     coloring polish, R:R header chip, snapshot image export for inline Telegram preview. -->
<meta property="og:title" content="Clawmimoto — Chart">
<meta property="og:description" content="Live annotated chart — Entry, SL, TP straight from the Clawmimoto engine.">
<meta property="og:image" content="https://clawtrader-landing.vercel.app/assets/og-join.jpg">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;700&family=JetBrains+Mono:wght@400;700;800&display=swap" rel="stylesheet">
<script src="https://unpkg.com/lightweight-charts@5/dist/lightweight-charts.standalone.production.js"></script>
<style>
  :root {
    --orange: #FF5500;
    --bg: #0B0B0D;
    --panel: rgba(255, 255, 255, 0.045);
    --panel-border: rgba(255, 255, 255, 0.09);
    --text: #F2F0EC;
    --muted: rgba(242, 240, 236, 0.55);
    --green: #2BD576;
    --red: #FF4757;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 32px 20px 48px;
    background-image: radial-gradient(ellipse 80% 50% at 50% -10%, rgba(255, 85, 0, 0.13), transparent);
  }
  .brand {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 28px;
    letter-spacing: 2px;
    color: var(--text);
    text-decoration: none;
  }
  .brand span { color: var(--orange); }
  .mock-badge {
    margin-top: 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--orange);
    border: 1px solid var(--orange);
    border-radius: 999px;
    padding: 4px 14px;
  }
  main { width: 100%; max-width: 720px; margin-top: 30px; }
  .head-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
  }
  .pair {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 34px;
    letter-spacing: 1px;
  }
  .dir-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    border-radius: 999px;
    padding: 5px 14px;
  }
  .dir-badge.long { color: var(--green); border: 1px solid var(--green); }
  .dir-badge.short { color: var(--red); border: 1px solid var(--red); }
  .dir-badge.none { color: var(--muted); border: 1px solid var(--panel-border); }
  .tf-row {
    display: flex;
    gap: 8px;
    margin-top: 18px;
  }
  .tf-row button {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--muted);
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 999px;
    padding: 7px 15px;
    cursor: pointer;
    transition: color .15s, border-color .15s;
  }
  .tf-row button:hover { color: var(--text); }
  .tf-row button.active { color: var(--orange); border-color: var(--orange); }
  #chart-wrap {
    margin-top: 16px;
    width: 100%;
    height: 420px;
    border: 1px solid var(--panel-border);
    border-radius: 14px;
    overflow: hidden;
    background: var(--panel);
    position: relative;
  }
  #chart-state {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    font-size: 14px;
  }
  .levels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 18px;
  }
  .level {
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 14px;
    padding: 14px 16px;
  }
  .level .label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .level .value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 18px;
    font-weight: 700;
    margin-top: 6px;
  }
  .level.entry .value { color: var(--text); }
  .level.tp .value { color: var(--green); }
  .level.sl .value { color: var(--red); }
  .rr-chip {
    margin-top: 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    color: var(--muted);
  }
  .cta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .cta {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 18px;
    letter-spacing: 1.5px;
    text-decoration: none;
    border-radius: 10px;
    padding: 12px 24px;
    transition: transform .15s;
  }
  .cta:hover { transform: translateY(-2px); }
  .cta.primary { color: #0B0B0D; background: var(--orange); }
  .cta.secondary { color: var(--text); border: 1px solid var(--panel-border); }
  .disclaimer {
    margin-top: 30px;
    max-width: 560px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--muted);
  }
  @media (max-width: 480px) {
    .levels { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>
  <a class="brand" href="/">CLAW<span>TRADER</span></a>
  <div class="mock-badge">MOCK ACCOUNT — SIMULATED FILLS</div>

  <main>
    <div class="head-row">
      <div class="pair" id="pairLabel">—</div>
      <div class="dir-badge none" id="dirBadge">SETUP</div>
    </div>

    <div class="tf-row" id="tfRow">
      <button data-tf="5">5m</button>
      <button data-tf="15" class="active">15m</button>
      <button data-tf="60">1h</button>
      <button data-tf="240">4h</button>
    </div>

    <div id="chart-wrap">
      <div id="chart-state">Loading chart…</div>
    </div>

    <div class="levels" id="levels" style="display:none;">
      <div class="level entry"><div class="label">Entry</div><div class="value" id="vEntry">—</div></div>
      <div class="level tp"><div class="label">Take profit</div><div class="value" id="vTp">—</div></div>
      <div class="level sl"><div class="label">Stop loss</div><div class="value" id="vSl">—</div></div>
    </div>
    <div class="rr-chip" id="rrChip"></div>

    <div class="cta-row">
      <a class="cta primary" id="tgLink" href="https://t.me/RightclawTrade">OPEN IN TELEGRAM</a>
      <a class="cta secondary" id="tvLink" href="#" target="_blank" rel="noopener">OPEN IN TRADINGVIEW</a>
    </div>

    <p class="disclaimer">
      Chart and levels reflect a simulated (MOCK) setup — no real funds are traded.
      Price data is delayed market data for reference only, not an execution feed.
      Nothing here is financial advice.
    </p>
  </main>

<script>
(function () {
  const symbol = (location.pathname.match(/^\/chart\/([A-Za-z0-9]+)/) || [])[1] || '';
  const qs = new URLSearchParams(location.search);
  const entry = parseFloat(qs.get('entry'));
  const sl = parseFloat(qs.get('sl'));
  const tp = parseFloat(qs.get('tp'));
  const dir = (qs.get('dir') || '').toUpperCase();

  const els = id => document.getElementById(id);

  els('pairLabel').textContent = symbol || '—';
  els('tvLink').href = symbol
    ? 'https://www.tradingview.com/chart/?symbol=BYBIT:' + encodeURIComponent(symbol) + '.P'
    : 'https://www.tradingview.com/';

  if (dir === 'LONG' || dir === 'SHORT') {
    const badge = els('dirBadge');
    badge.textContent = dir;
    badge.className = 'dir-badge ' + dir.toLowerCase();
  }

  const hasLevels = [entry, sl, tp].every(v => Number.isFinite(v));
  if (hasLevels) {
    els('levels').style.display = 'grid';
    els('vEntry').textContent = entry;
    els('vTp').textContent = tp;
    els('vSl').textContent = sl;
    const risk = Math.abs(entry - sl);
    const reward = Math.abs(tp - entry);
    if (risk > 0) {
      els('rrChip').textContent = 'R:R ' + (reward / risk).toFixed(2);
    }
  }

  if (!symbol) {
    els('chart-state').textContent = "No symbol given — open this link from a Telegram card.";
    return;
  }

  let chart, series;

  function initChart() {
    const wrap = els('chart-wrap');
    chart = LightweightCharts.createChart(wrap, {
      layout: { background: { color: 'transparent' }, textColor: '#F2F0EC' },
      grid: {
        vertLines: { color: 'rgba(255,255,255,0.06)' },
        horzLines: { color: 'rgba(255,255,255,0.06)' },
      },
      timeScale: { timeVisible: true, secondsVisible: false },
      rightPriceScale: { borderColor: 'rgba(255,255,255,0.09)' },
      autoSize: true,
    });
    series = chart.addSeries(LightweightCharts.CandlestickSeries, {
      upColor: '#2BD576', downColor: '#FF4757',
      borderVisible: false,
      wickUpColor: '#2BD576', wickDownColor: '#FF4757',
    });
  }

  function drawLevels() {
    if (!hasLevels || !series) return;
    series.createPriceLine({
      price: entry, color: '#F2F0EC', lineWidth: 1,
      lineStyle: LightweightCharts.LineStyle.Dashed, axisLabelVisible: true, title: 'Entry',
    });
    series.createPriceLine({
      price: tp, color: '#2BD576', lineWidth: 2,
      lineStyle: LightweightCharts.LineStyle.Solid, axisLabelVisible: true, title: 'TP',
    });
    series.createPriceLine({
      price: sl, color: '#FF4757', lineWidth: 2,
      lineStyle: LightweightCharts.LineStyle.Solid, axisLabelVisible: true, title: 'SL',
    });
  }

  async function loadCandles(interval) {
    els('chart-state').style.display = 'flex';
    els('chart-state').textContent = 'Loading chart…';
    try {
      const r = await fetch('/api/klines?symbol=' + encodeURIComponent(symbol) + '&interval=' + interval + '&limit=200');
      const d = await r.json();
      if (!r.ok || !d.candles || !d.candles.length) {
        els('chart-state').textContent = 'No chart data available for ' + symbol + '.';
        return;
      }
      if (!chart) initChart();
      series.setData(d.candles);
      drawLevels();
      chart.timeScale().fitContent();
      els('chart-state').style.display = 'none';
    } catch (e) {
      els('chart-state').textContent = 'Chart failed to load.';
    }
  }

  els('tfRow').addEventListener('click', (e) => {
    const b = e.target.closest('button');
    if (!b) return;
    document.querySelectorAll('#tfRow button').forEach(x => x.classList.remove('active'));
    b.classList.add('active');
    loadCandles(b.dataset.tf);
  });

  loadCandles('15');
})();
</script>
</body>
</html>
